# Copy this file to `.env` (same folder) and fill in what you need.
# `.env` is git-ignored, so your API key never gets committed.
# Bun loads `.env` automatically when you run `bun run dev:cli` from this folder.

# --- Option A: OpenRouter (cloud, hundreds of models) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Option B: Ollama (local, free, offline) ---
# Install Ollama, then e.g. `ollama pull llama3.2`. No key needed.
# Only change this if Ollama runs on another port or machine.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Optional ---
# Override the saved provider on launch. Leave unset to restore /models choices.
# NIGHTOWL_PROVIDER=openrouter

# Override the saved model on launch. Leave unset to restore /models choices.
# OpenRouter default: anthropic/claude-sonnet-5.5 (free models end in ":free")
# Ollama default:     llama3.2
# NIGHTOWL_MODEL=

# Optional local storage override for sessions, settings and saved credentials.
# Default: your OS's application data directory.
# NIGHTOWL_DATA_DIR=C:/Users/you/AppData/Local/NightOwl
